# SPDX-License-Identifier: AGPL-3.0-or-later
# All rules are ordinary source functions. Fields 10..13 are row-major.
let matrix = (a, b, c, d) =>
    add(index(10, a), index(11, b), index(12, c), index(13, d))
let m00 = (m) => camera(10, 0, m)
let m01 = (m) => camera(11, 0, m)
let m10 = (m) => camera(12, 0, m)
let m11 = (m) => camera(13, 0, m)
let matmul = (a, b) =>
    matrix(
        add(multiply(m00(a), m00(b)), multiply(m01(a), m10(b))),
        add(multiply(m00(a), m01(b)), multiply(m01(a), m11(b))),
        add(multiply(m10(a), m00(b)), multiply(m11(a), m10(b))),
        add(multiply(m10(a), m01(b)), multiply(m11(a), m11(b)))
    )
# Repeated x must match the same expression, not just a sample value.
let before = (a, b, x) => add(matmul(a, x), matmul(b, x))
let after = (a, b, x) => matmul(add(a, b), x)
let optimize_matrix = (graph) => rewrite(graph, trace(before), trace(after))
# The pattern is nested inside an output wrapper.
let calculate = (a, b, x) =>
    index(40, add(matmul(a, x), matmul(b, x)))
let original = trace(calculate)
let improved = optimize_matrix(original)
let a = matrix(1, 2, 3, 4)
let b = matrix(5, 6, 7, 8)
let x = matrix(2, 0, 1, 3)
# Run the REWRITTEN graph, not the separately authored after function.
# Expected fields 10..13 under direction 40: 20, 24, 32, 36.
output apply(improved, a, b, x) as pattern
