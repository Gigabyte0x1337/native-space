# Apply the selected finite pattern at one positive position.

let observations = () =>
add(
  index(1, 1),
  index(2, 1),
  index(3, 2),
  index(4, 3),
  index(5, 5),
  index(6, 8),
  index(7, 13),
  index(8, 21),
  index(9, 35)
)

output apply(rank_descent(observations()), 13) as vector
