# The visible answer is 1, but x and its cancelled multiplication survive.
# Bare output and 'as pattern' expose the retained state.
# Change the final output to 'as number' to observe only the classical answer.
let x = 7
let cancelled = multiply(x, 0)
output add(cancelled, 1)
