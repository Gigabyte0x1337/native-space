# SPDX-License-Identifier: AGPL-3.0-or-later
# Pattern first: functions transform a movement, not a numerical approximation.
# Run: native-space run examples/movement-patterns.ns
# Check the defining law by replacing the last line with:
# difference(compose(sqrt(movement(2, 1/4)), sqrt(movement(2, 1/4))), movement(2, 1/4)) = 0
# This checks the coordinate law. The full retained histories remain distinct.
#
# A movement has two supplied rational coordinates: scaling depth and turns.
# One depth step means doubling. One turn means one complete rotation.
# This is a source-defined chart, not a new primitive or a runtime coordinate
# getter. All movement arguments below must be constructed with movement().
# A plain scalar such as 4 is NOT the movement that reaches 4.
# INDEX fields 1/2 hold coordinates; field 3 records the fixed scale base 2.
# Field labels do not measure distance or imply three independent dimensions.
#
# Turns are unwrapped fractions: 0, 1/4, 1/2, 1, 5/4, ... remain distinct.
# This differs from operation-patterns.ns's rational steering coordinate t:
# here 1/2 actually means half a turn, not the direction (3/5,4/5).
# Do not confuse these coordinates with PHASE's four discrete coefficients.
# PHASE(2,x) below negates a coordinate; turn(1/2) constructs a movement.
#
# Classical interpretation, used ONLY for verification/readout:
# magnitude = 2^depth; direction completes one cycle per unit turn.
# Identity (0,0) reaches 1. Exact numerical zero is not in this nonzero chart.
# General magnitudes/directions can be irrational: this file does not pretend
# `as number` decodes the movement or silently call host pow/sqrt/sin/cos.
# The generic movement laws below are exact for every rational input coordinate.

let opposite = (x) => phase(2, x)
let difference = (a, b) => add(a, opposite(b))
let movement = (depth, turns) => add(index(1, depth), index(2, turns), index(3, 2))
let depth_of = (p) => camera(1, 0, p)
let turns_of = (p) => camera(2, 0, p)
let identity = () => movement(0, 0)

# GENERIC: follow one movement with another; reverse it; take a fraction of it.
# No function here asks what the classical endpoint happens to be.
let compose = (p, q) => movement(add(depth_of(p), depth_of(q)), add(turns_of(p), turns_of(q)))
let reverse = (p) => movement(opposite(depth_of(p)), opposite(turns_of(p)))
let portion = (p, fraction) => movement(multiply(fraction, depth_of(p)), multiply(fraction, turns_of(p)))
let between = (start, finish) => compose(reverse(start), finish)
let interpolate = (start, finish, fraction) => compose(start, portion(between(start, finish), fraction))
let step = (state, next) => compose(state, next)
let chain = (steps...) => fold(step, identity(), steps...)

# NAMED MEANINGS of those SAME transformations, not different algorithms.
# sqrt is the movement which, followed twice, gives the supplied movement.
let sqrt = (p) => portion(p, 1/2)
let square = (p) => portion(p, 2)
let cube = (p) => portion(p, 3)
let reciprocal = (p) => reverse(p)
let quotient = (p, q) => compose(p, reverse(q))
let power = (p, exponent) => portion(p, exponent)
let turn = (fraction) => movement(0, fraction)
let grow = (depth) => movement(depth, 0)
# For zero-turn positive movements, log2 reads the position and exp2 constructs
# it. The base is explicit: these are NOT natural log/exp of arbitrary scalars.
let log2 = (p) => depth_of(p)
let exp2 = (depth) => grow(depth)

# A classical endpoint can have several lifted paths. Keeping winding makes
# root choice explicit instead of forcing a principal-value convention.
# sqrt(turn(1)) is a half turn, whereas sqrt(identity()) is no turn.
# Their inputs have the SAME classical endpoint 1, but are different movements.
# other_sqrt squares to the input PLUS one full turn, hence the same endpoint,
# not the same lifted movement. Do not claim lifted equality for that branch.
let other_sqrt = (p) => compose(sqrt(p), turn(1/2))

# GENERIC subdivision: keep a start and a movement, then split that segment.
# Nesting keeps both children. It does not just replace the parent by a number.
# Segment fields 10/11; subdivision fields 20/21. All operations retain inputs.
let segment = (start, advance) => add(index(10, start), index(11, advance))
let start_of = (s) => camera(10, 0, s)
let advance_of = (s) => camera(11, 0, s)
let finish_of = (s) => compose(start_of(s), advance_of(s))
let bisect = (s) => add(
    index(20, segment(start_of(s), portion(advance_of(s), 1/2))),
    index(21, segment(compose(start_of(s), portion(advance_of(s), 1/2)),
        portion(advance_of(s), 1/2))))
let first_half = (split) => camera(20, 0, split)
let second_half = (split) => camera(21, 0, split)

# Four successive quarter-cycle segments, each split in half. This realizes a
# concrete four-way halving construction WITHOUT calling it a pi algorithm.
# It describes subdivisions of a movement, not yet Euclidean side lengths.
# A circumference/diameter readout would need its own specified camera and law.
let four_way = () => concat(9,
    bisect(segment(turn(0), turn(1/4))),
    bisect(segment(turn(1/4), turn(1/4))),
    bisect(segment(turn(1/2), turn(1/4))),
    bisect(segment(turn(3/4), turn(1/4))))

# SCOPE: sqrt/powers, quotient/reversal, log2/exp2 and subdivision have direct
# definitions here. General ADD of endpoints is not coordinate composition;
# sine/cosine need a direction readout; order/mod need a chosen discrete encoding;
# pi needs a length measurement. Those remain in the reference experiments,
# not hidden inside these generic functions or replaced by unimplemented names.
#
# Example: depth 2 reaches magnitude 4; taking half reaches depth 1 (magnitude 2).
# No iteration, convergence threshold, numerical coefficient table, or host math.
output sqrt(grow(2)) as pattern
