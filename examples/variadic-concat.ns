# Variadic packs are source patterns. concat lowers each supplied value to a
# different INDEX depth and joins the generated terms with ADD.

let parameters = (values...) =>
concat(9, values...)

# Forwarding a pack does not turn it into an array or runtime value.
let forwarded_parameters = (values...) =>
parameters(values...)

let generated = () =>
forwarded_parameters(2, 3, 5)

let written_with_core_operations = () =>
add(
  index(9, 2),
  index(9, index(9, 3)),
  index(9, index(9, index(9, 5)))
)

# The generated concat pattern is exactly its pure ADD/INDEX expansion.
add(generated(), orient(2, written_with_core_operations())) = 0
