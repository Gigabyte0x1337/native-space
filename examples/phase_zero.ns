# Pure native four-phase cancellation: 1 + J + (-1) + (-J) = 0.

let native_one = one
let native_j = phase(1, native_one)
let native_minus_one = phase(2, native_one)
let native_minus_j = phase(3, native_one)
output add(native_one, native_j, native_minus_one, native_minus_j)
