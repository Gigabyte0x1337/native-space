# One exact quarter-turn mode sampled at sixteen consecutive INDEX positions.

let observations = () =>
add(
  index(1, 1),
  index(2, phase(1, 1)),
  index(3, phase(2, 1)),
  index(4, phase(3, 1)),
  index(5, 1),
  index(6, phase(1, 1)),
  index(7, phase(2, 1)),
  index(8, phase(3, 1)),
  index(9, 1),
  index(10, phase(1, 1)),
  index(11, phase(2, 1)),
  index(12, phase(3, 1)),
  index(13, 1),
  index(14, phase(1, 1)),
  index(15, phase(2, 1)),
  index(16, phase(3, 1))
)

output observations() as pattern
