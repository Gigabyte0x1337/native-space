# One exact quarter-turn mode sampled at sixteen consecutive INDEX positions.

let observations = () =>
add(
  index(1, 1),
  index(2, orient(1, 1)),
  index(3, orient(2, 1)),
  index(4, orient(3, 1)),
  index(5, 1),
  index(6, orient(1, 1)),
  index(7, orient(2, 1)),
  index(8, orient(3, 1)),
  index(9, 1),
  index(10, orient(1, 1)),
  index(11, orient(2, 1)),
  index(12, orient(3, 1)),
  index(13, 1),
  index(14, orient(1, 1)),
  index(15, orient(2, 1)),
  index(16, orient(3, 1))
)

output observations() as pattern
