# Matrix/operator witness: one exact instance of native distributivity.
# Subtraction is ADD with a two-turn ORIENT.
let matrix_operator = index(1, scalar(2, 1))
let left_input = index(2, scalar(3, -1))
let right_input = index(3, scalar(-1, 2))
let combined = multiply(matrix_operator, add(left_input, right_input))
let separated = add(
    multiply(matrix_operator, left_input),
    multiply(matrix_operator, right_input)
)
add(combined, orient(2, separated)) = 0
