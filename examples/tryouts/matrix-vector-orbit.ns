# SPDX-License-Identifier: AGPL-3.0-or-later
# Try-out: repeatedly apply one exact 2x2 matrix to a complete vector state.
# Matrix coordinates 10..13 are a11, a12, a21, a22.
# Vector coordinates 2 and 3 are x and y.

let matrix = (a11, a12, a21, a22) =>
add(index(10, a11), index(11, a12), index(12, a21), index(13, a22))

let point = (x, y) => add(index(2, x), index(3, y))

let a11 = (value) => camera(10, 0, value)
let a12 = (value) => camera(11, 0, value)
let a21 = (value) => camera(12, 0, value)
let a22 = (value) => camera(13, 0, value)
let x = (value) => camera(2, 0, value)
let y = (value) => camera(3, 0, value)

let matrix_vector = (transform, point) =>
point(
  add(multiply(a11(transform), x(point)), multiply(a12(transform), y(point))),
  add(multiply(a21(transform), x(point)), multiply(a22(transform), y(point)))
)

let transform = () => matrix(2, 1, 1, 1)
let v0 = () => point(1, 0)
let v1 = () => matrix_vector(transform(), v0())
let v2 = () => matrix_vector(transform(), v1())
let v3 = () => matrix_vector(transform(), v2())
let v4 = () => matrix_vector(transform(), v3())
let v5 = () => matrix_vector(transform(), v4())
let v6 = () => matrix_vector(transform(), v5())
let v7 = () => matrix_vector(transform(), v6())
let v8 = () => matrix_vector(transform(), v7())

let observations = () =>
add(
  index(1, v0()),
  index(1, index(1, v1())),
  index(1, index(1, index(1, v2()))),
  index(1, index(1, index(1, index(1, v3())))),
  index(1, index(1, index(1, index(1, index(1, v4()))))),
  index(1, index(1, index(1, index(1, index(1, index(1, v5())))))),
  index(1, index(1, index(1, index(1, index(1, index(1, index(1, v6()))))))),
  index(1, index(1, index(1, index(1, index(1, index(1, index(1, index(1, v7())))))))),
  index(1, index(1, index(1, index(1, index(1, index(1, index(1, index(1, index(1, v8())))))))))
)

output observations() as pattern
