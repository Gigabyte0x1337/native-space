# Definition order is precedence: MULTIPLY binds before subtraction.

let subtract = (left, right) => add(left, orient(2, right))

operator "*" = (left, right) => multiply(left, right)
operator "-" = (left, right) => subtract(left, right)

output 10 - 2 * 3
