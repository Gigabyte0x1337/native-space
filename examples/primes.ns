# Observe the one prime pattern at k = 3. The 3 is identity 2 is depth.
let third_prime_squared = index(3, index(3, one))

# Wrapped birth phase is a separate coefficient state.
let third_prime_phase = phase(3, one)

# One observation of the generative pattern combines identity and phase.
let third_pattern_observation = phase(3, index(3, one))

output add(
    third_prime_squared,
    third_prime_phase,
    third_pattern_observation
)
