# This sequence has no supported exact deterministic continuation.

let observations = () =>
add(
  index(1, 1),
  index(2, 1),
  index(3, 2),
  index(4, 3),
  index(5, 5),
  index(6, 8),
  index(7, 13),
  index(8, 21),
  index(9, 35)
)

# Retain the strongest one fifth of all relationship-frequency channels.
output untrace(observations(), 1/5) as pattern
