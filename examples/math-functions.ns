# Native Space 1.0 mathematical examples.
#
# Function names are ordinary source data. The Rust expander knows none of
# their mathematical meaning. Calls are fully erased to the four core
# operations.

import "../language/functions.ns"

let prime_birth = () =>
INDEX()

let prime_power = () =>
INDEX()

# pi denotes the prime-counting camera pi(n), not the circle constant.
let pi = () =>
INDEX()
ADD()

let birth_orient = () =>
ORIENT("k mod 4")

let classic_p = () =>
ORIENT(0)

# The classical source number line has one coordinate. A later camera may
# zero-fill absent coordinates, but they are not additional source axes.
let classical_source_axis = () =>
classic_p()

let classic_i = () =>
ORIENT(1)

# Half of the multiplicative identity is the unique center of
# the reflection sigma -> 1 - sigma.
let exact_half = () =>
ADD()
MULTIPLY()

let centered_re_perspective = () =>
axis_subtract(classic_p, exact_half)

let p_minus_i = () =>
ORIENT(3)

let p_i = () =>
ORIENT(1)

let p_one = () =>
ORIENT(0)

let p_minus_one = () =>
ORIENT(2)

let classical_four_projection = () =>
apply(p_minus_i, p_i, p_one, p_minus_one)

let four_axis_cancellation = () =>
classical_four_projection()
ADD()
ADD()

let opposite_birth_pair = () =>
birth_orient()
ORIENT(2)
MULTIPLY()
ADD()

